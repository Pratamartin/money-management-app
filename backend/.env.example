SECRET_KEY=troque-por-uma-chave-secreta-longa
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Desenvolvimento local (docker-compose)
POSTGRES_DB=moneymgt
POSTGRES_USER=moneymgt
POSTGRES_PASSWORD=moneymgt

# Railway injeta DATABASE_URL automaticamente ao adicionar o plugin Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/db

# origens permitidas — separadas por vírgula, sem barra no final
# Em produção: o domínio do Railway e o IP do app Android
# ex: https://moneymgt.up.railway.app
# 10.0.2.2 = emulador Android acessando o host
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://10.0.2.2:8000
